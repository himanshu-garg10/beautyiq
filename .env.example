# BeautyIQ Environment Variables Template
# Copy this file to .env or .env.local for development and production deployment.
# NEVER commit real API keys, passwords, or production secrets to source control.

# Database Configuration (Prisma with MongoDB Atlas)
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/beautyiq?retryWrites=true&w=majority"

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Session & Security
# Generate a strong 32+ character random secret for production sessions
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production
SESSION_EXPIRY_SECONDS=86400

# NextAuth (Auth.js v4)
# Generate a separate 32+ character random secret (e.g. openssl rand -base64 32)
NEXTAUTH_SECRET=change-this-to-a-secure-random-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Comma-separated email addresses allowed to import external product catalog data.
ADMIN_EMAILS=admin@example.com

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000

# Data Pipeline & Verified Partner Sources
RETAILER_PARTNER_API_KEY=your_retailer_partner_api_key_here
BRAND_DIRECT_API_KEY=your_brand_direct_api_key_here

# AI & Semantic Search Engine
# Skincare chat (AI Match) LLM provider: gemini | openai | anthropic | internal-rule-based
# Leave AI_ENGINE_PROVIDER unset to use Gemini automatically when GEMINI_API_KEY is set.
# The chat works without any LLM (deterministic extraction/ranking); the LLM only helps parse
# free-form messages and phrase replies, and can never change product names, prices or links.
AI_ENGINE_PROVIDER=internal-rule-based
# AI_MODEL=                      # optional model override for the chosen provider
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# ANTHROPIC_API_KEY=
AI_TIMEOUT_MS=8000

# Gemini AI (required for AI Match and Face Skin Scan features)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional — defaults to gemini-2.0-flash-lite
GEMINI_MODEL=gemini-2.0-flash-lite

# Audit Logging & Monitoring
ADMIN_AUDIT_LOGGING_ENABLED=true
LOG_LEVEL=info
