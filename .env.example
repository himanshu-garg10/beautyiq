# BeautyIQ Production Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit real API keys, passwords, or production secrets to source control.

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Session & Security
# Generate a strong 32+ character random secret for production sessions
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production
SESSION_EXPIRY_SECONDS=86400

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000

# Data Pipeline & Verified Partner Sources
# Partner APIs require authorized tokens in production
RETAILER_PARTNER_API_KEY=your_retailer_partner_api_key_here
BRAND_DIRECT_API_KEY=your_brand_direct_api_key_here

# AI & Semantic Search Engine
AI_ENGINE_PROVIDER=internal-rule-based
AI_TIMEOUT_MS=5000

# Audit Logging & Monitoring
ADMIN_AUDIT_LOGGING_ENABLED=true
LOG_LEVEL=info
